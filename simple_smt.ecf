<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_smt" uuid="2C7B9E14-6A3D-4F58-9B02-7E1C5D8A4F63" library_target="simple_smt">
	<description>Native Eiffel binding to the Z3 SMT solver's C API (build, assert, decide, prove)</description>
	<target name="simple_smt">
		<root all_classes="true"/>
		<version major="1" minor="0" release="0" build="1"/>
		<option warning="warning" syntax="standard" manifest_array_type="mismatch_warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<capability>
			<concurrency support="scoop"/>
			<void_safety support="all"/>
		</capability>
		<external_include location="$(SIMPLE_EIFFEL)\simple_smt\Clib"/>
		<external_object location="$(SIMPLE_EIFFEL)\simple_smt\lib\libz3.lib"/>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf">
			<class_option class="ARRAYED_LIST">
				<warning name="obsolete_feature" value="all"/>
			</class_option>
		</library>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
	<target name="simple_smt_tests" extends="simple_smt">
		<description>Test suite for simple_smt</description>
		<root class="TEST_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<setting name="executable_name" value="test_app"/>
		<library name="simple_testing" location="$SIMPLE_EIFFEL\simple_testing\simple_testing.ecf"/>
		<cluster name="test" location=".\test\" recursive="true"/>
	</target>
	<target name="simple_smt_app" extends="simple_smt">
		<description>simple_smt demo executable</description>
		<root class="SMT_APP" feature="make"/>
		<setting name="console_application" value="true"/>
		<setting name="executable_name" value="simple_smt"/>
		<cluster name="app" location=".\app\" recursive="true"/>
	</target>
</system>
